              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "minItems": 1,
                "maxItems": 10000,
                "uniqueItems": true
              },
              "hunter": {
                "type": "object",
                "properties": {
                  "identity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
