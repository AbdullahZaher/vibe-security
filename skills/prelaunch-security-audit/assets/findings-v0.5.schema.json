                "minItems": 0,
                "maxItems": 10000,
                "uniqueItems": true
              },
              "demonstrated_impact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "conditional_impacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "minItems": 0,
                "maxItems": 10000,
                "uniqueItems": true
              },
              "impact_basis": {
                "enum": [
