              "minimal_fix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "regression_plan": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "residual_unknowns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "minItems": 0,
                "maxItems": 10000,
                "uniqueItems": true
              },
              "inventory_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
