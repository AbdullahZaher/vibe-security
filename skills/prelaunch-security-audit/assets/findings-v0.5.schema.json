          "id",
          "finding_id",
          "target",
          "revision",
          "actor",
          "resource",
          "kind",
          "method",
          "expected",
          "observed",
          "result",
          "sources",
          "command",
          "exit_code",
          "invariant_id",
          "provenance",
          "failure_kind",
          "test_definition_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
