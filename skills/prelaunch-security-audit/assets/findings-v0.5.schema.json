                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "profile": {
                  "enum": [
                    "standard",
                    "deep"
                  ]
                },
                "verdict": {
                  "enum": [
                    "confirmed",
                    "needs_validation",
                    "rejected"
                  ]
                },
                "severity": {
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low",
                    "informational",
                    "none"
                  ]
                },
                "confidence": {
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "verification_tier": {
                  "enum": [
                    "source",
                    "build",
                    "runtime",
                    "deployment",
                    "not_verified"
