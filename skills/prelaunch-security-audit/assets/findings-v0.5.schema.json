                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "actor": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "resource": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
