                  "minItems": 0,
                  "maxItems": 10000,
                  "uniqueItems": true
                },
                "disproof_attempt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "next_check": {
                  "type": "string"
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "minItems": 0,
                  "maxItems": 10000,
                  "uniqueItems": true
                }
