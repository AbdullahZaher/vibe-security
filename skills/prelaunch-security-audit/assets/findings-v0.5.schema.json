                  "context": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "identity",
                  "context"
                ],
                "additionalProperties": false
              },
              "invariants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "property": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "actors": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
