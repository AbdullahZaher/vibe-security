{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.5 finding adjudication and remediation bundle",
  "description": "Structural consistency only; use validate_findings.py for semantic checks and frozen-source verification. Host attestations must arrive through a separately trusted channel.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "revision": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "source_analysis",
              "scanner",
              "build",
              "runtime",
              "deployment"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "result": {
            "enum": [
              "observed",
              "pass",
              "fail",
              "blocked",
              "not_run"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "revision": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "status": {
                  "enum": [
                    "verified",
                    "not_verified"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{64})?$"
                }
              },
              "required": [
                "path",
                "line_start",
                "line_end",
                "revision",
                "status",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "invariant_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "operator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "timestamp": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "origin": {
                "enum": [
                  "source_inspection",
                  "host_log",
                  "scanner_output"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            },
            "required": [
              "operator",
              "timestamp",
              "environment",
              "origin",
              "reference"
            ],
            "additionalProperties": false
          },
          "failure_kind": {
            "enum": [
              "security_invariant",
              "quality",
              "environment",
              "none"
            ]
          },
          "test_definition_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
