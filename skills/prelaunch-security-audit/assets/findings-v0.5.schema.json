              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "revision": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "component": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "root_cause": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "entry_point": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "actor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "resource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "trust_boundary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "trace": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "minItems": 1,
                "maxItems": 10000,
                "uniqueItems": true
              },
              "defenses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
