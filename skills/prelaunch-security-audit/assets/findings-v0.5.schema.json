                    "identity": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "context": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "independent": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "identity",
                    "context",
                    "independent"
