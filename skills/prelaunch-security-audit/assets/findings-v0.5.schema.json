                    "status": {
                      "enum": [
                        "verified",
                        "unknown",
                        "impossible"
                      ]
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "minItems": 0,
                      "maxItems": 10000,
                      "uniqueItems": true
                    }
