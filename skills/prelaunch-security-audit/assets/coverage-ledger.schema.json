{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.5"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "mode": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "unknown_outside_inventory": {
      "const": true
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "inventory_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "boundary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "attack_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "covered",
              "partially_covered",
              "blocked",
              "deferred",
              "not_applicable",
              "unassessed"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "revision": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "verification_method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          }
        },
        "required": [
          "unit_id",
          "inventory_ids",
          "boundary",
          "attack_class",
          "actors",
          "resources",
          "status",
          "reviewer",
          "revision",
          "verification_method",
          "evidence_ids",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "inventory_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "revision": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "boundary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "kind": {
            "enum": [
              "source_inspection",
              "architecture_inspection",
              "test"
            ]
          },
          "tier": {
            "enum": [
              "source",
              "build",
              "runtime",
              "deployment"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "operator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "timestamp": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "result": {
            "enum": [
              "observed",
              "pass",
              "fail",
              "not_run",
              "blocked",
              "inconclusive"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "\\S"
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "revision": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "status": {
                  "enum": [
                    "verified",
                    "not_verified"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{64})?$"
                }
              },
              "required": [
                "path",
                "line_start",
                "line_end",
                "revision",
                "status",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "artifact": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "unit_id",
          "inventory_ids",
          "target",
          "revision",
          "boundary",
          "actors",
          "resources",
          "kind",
          "tier",
          "method",
          "environment",
          "operator",
          "timestamp",
          "observed",
          "result",
          "source_refs",
          "artifact"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "target",
    "revision",
    "mode",
    "unknown_outside_inventory",
    "units",
    "evidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coverage of discovered units, separate from controls and discovery"
}
